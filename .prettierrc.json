{
    "printWidth": 160,
    "tabWidth": 4,
    "trailingComma": "es5",
    "singleQuote": true,
    "plugins": [
        "prettier-plugin-blade"
    ],
    "overrides": [
        {
            "files": [
                "**/*.blade.php"
            ],
            "options": {
                "parser": "blade",
                "printWidth": 300
            }
        }
    ]
}
