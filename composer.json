{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "onpaysb/lab",
    "type": "project",
    "description": "The LAB stack boilerplate",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "apih/laravel-jslang": "^1.2.10",
        "laravel/framework": "^13.21.1",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "onpay/laravel-core": "^0.1.66"
    },
    "require-dev": {
        "apih/laravel-lang-helper": "^1.1.6",
        "apih/laravel-route-list-web": "^1.6.1",
        "barryvdh/laravel-ide-helper": "^3.7.0",
        "fakerphp/faker": "^1.24.1",
        "itsgoingd/clockwork": "^5.3.5",
        "laravel/pao": "^1.1.2",
        "laravel/pint": "^1.29.3",
        "laravel/sail": "^1.64.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^12.5.31",
        "spatie/laravel-ignition": "^2.12.0",
        "spatie/laravel-web-tinker": "^1.10.6"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.onpay.my"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:patch:apply --ansi",
            "@php artisan ide-helper:all --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
